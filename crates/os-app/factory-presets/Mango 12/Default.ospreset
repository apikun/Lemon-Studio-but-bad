OSPRESET 1
plugin=Mango 12	id=clap:org.openstudio.mango-12	format=clap	body=params
# The converter as it ships: the filter bypassed, the whole stereo pair, no gain, no detune.
# A gain's value is a step count from the parameter's reported minimum (-12 dB): 120 = 0 dB.
Tune = 0
Fine = 0
Range = 0
Gain In = 120
Gain Out = 120
Link = 0
Filter = 99
Route = 0
Mix = 100
Crush = 0
